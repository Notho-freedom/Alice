# ── Kilo ────────────────────────────────────────────────────────────────
KILO_HOST=127.0.0.1
KILO_PORT=4096
KILO_BASE_URL=http://${KILO_HOST}:${KILO_PORT}
KILO_DIRECTORY=.
KILO_AUTO_APPROVE=false

# ── Audio ───────────────────────────────────────────────────────────────
AUDIO_INPUT_DEVICE=1
AUDIO_OUTPUT_DEVICE=3
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=1024
AUDIO_CHANNELS=1

# ── VAD ─────────────────────────────────────────────────────────────────
VAD_SENSITIVITY=2
VAD_MIN_SPEECH_MS=80
VAD_MIN_SILENCE_MS=400

# ── Wake Word ───────────────────────────────────────────────────────────
WAKE_WORD=hey assistant

# ── STT ─────────────────────────────────────────────────────────────────
STT_PROVIDER=deepgram
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
STT_DETECT_LANGUAGE=true
STT_LANGUAGE=en-US

# ── TTS ─────────────────────────────────────────────────────────────────
# Priority chain: ElevenLabs → VAPI → Edge → Pi TTS → pyttsx3
TTS_PROVIDER=auto
TTS_RATE=200
TTS_VOLUME=1.0
TTS_VOICE=en-US-AriaNeural
TTS_BACKEND_URL=http://127.0.0.1:8000
TTS_LANGUAGE=

# ElevenLabs (cloud, high quality)
ELEVENLABS_API_KEY=

# VAPI (cloud, good quality)
VAPI_API_KEY=
VAPI_VOICE_ID=
VAPI_BASE_URL=https://api.vapi.ai

# Pi TTS (local backend)
PI_TTS_URL=http://127.0.0.1:8001

# ── Interrupt ───────────────────────────────────────────────────────────
INTERRUPT_THRESHOLD_MS=300

# ── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=